<IfModule mod_rewrite.c>
    RewriteEngine On

    # ----------------------------------------------------------------------
    # 1. Redirect www to non-www (Specific for laravelexpert.in)
    # ----------------------------------------------------------------------
    RewriteCond %{HTTP_HOST} ^www\.laravelexpert\.in [NC]
    RewriteRule ^(.*)$ https://laravelexpert.in/$1 [L,R=301]

    # If the request is not already for the /public/ folder, and the file
    # doesn't exist as-is, quietly serve it from /public/ instead — the
    # browser's address bar never shows "/public/".
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
